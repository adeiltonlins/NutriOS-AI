GEMINI_API_KEY=sua_chave_aqui

# Configuração do nutricionista parceiro (personaliza como o Bruce se apresenta)
NUTRICIONISTA_NOME=Dra. Exemplo
NUTRICIONISTA_ESPECIALIDADE=emagrecimento e reeducação alimentar
# Usado só como fallback, se o Mercado Pago abaixo não estiver configurado:
LINK_AGENDAMENTO=https://calendly.com/seu-link-aqui

# Supabase (armazenamento de leads/conversas) — veja README para criar a tabela
SUPABASE_URL=
SUPABASE_KEY=
ADMIN_TOKEN=escolha_um_token_secreto_para_acessar_o_painel

# Mercado Pago (Checkout Pro — link de pagamento com valor fixo)
# Token em: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=
VALOR_CONSULTA=150.00
NOME_ITEM_PAGAMENTO=Consulta nutricional
# URL pública do seu serviço no Render (sem barra no final), ex:
# https://nutri-chatbot-8h6k.onrender.com
URL_BASE=

# Contato liberado pro paciente SÓ depois do pagamento confirmado
# (ex: link do WhatsApp do nutricionista, formato https://wa.me/55DDDNUMERO)
CONTATO_NUTRICIONISTA=
