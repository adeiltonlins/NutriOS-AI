GEMINI_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Configuração do nutricionista parceiro (personaliza como o Bruce se apresenta)
NUTRICIONISTA_NOME=Dra. Exemplo
NUTRICIONISTA_ESPECIALIDADE=emagrecimento e reeducação alimentar
# Usado só como fallback, se o Mercado Pago abaixo não estiver configurado:
LINK_AGENDAMENTO=https://calendly.com/seu-link-aqui

# Supabase (armazenamento de leads/conversas) — veja README para criar a tabela
SUPABASE_URL=
SUPABASE_KEY=
ADMIN_TOKEN=escolha_um_token_secreto_para_acessar_o_painel
ADMIN_IDENTIFIER=admin

# Autenticação SaaS (gere valores longos e aleatórios; nunca reutilize API keys)
SESSION_SECRET=
APP_TOKEN_SECRET=
SESSION_DURATION=28800
PATIENT_SESSION_DURATION=2592000
ACCESS_CODE_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT=5/minute
CODE_GENERATION_RATE_LIMIT=10/minute
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
MAX_BODY_BYTES=1048576
IA_ATIVA=true

# Notificações por e-mail (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FREE_MESSAGE_LIMIT=8

# Mercado Pago (Checkout Pro — link de pagamento com valor fixo)
# Token em: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=
VALOR_CONSULTA=150.00
NOME_ITEM_PAGAMENTO=Consulta nutricional
# URL pública do seu serviço no Render (sem barra no final), ex:
# https://nutri-chatbot-8h6k.onrender.com
URL_BASE=

# Domínio(s) que podem chamar o /chat direto do navegador (CORS).
# Separe por vírgula se tiver mais de um. Sem isso, cai no URL_BASE.
# Ex: https://seusite.com.br,https://www.seusite.com.br
ALLOWED_ORIGINS=

# Contato liberado pro paciente SÓ depois do pagamento confirmado
# (ex: link do WhatsApp do nutricionista, formato https://wa.me/55DDDNUMERO)
CONTATO_NUTRICIONISTA=

# Google Agenda (opcional; o sistema funciona normalmente sem estas variáveis)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
CALENDAR_TOKEN_SECRET=
